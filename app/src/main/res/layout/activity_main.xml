<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="divso hub"
            android:textColor="#C084FC"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="delta executor"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- status -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="tap a game to inject"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="#C084FC" />

        <!-- divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F1F1F"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GAMES"
            android:textColor="#6B7280"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="12dp" />

        <!-- game buttons injected here -->
        <LinearLayout
            android:id="@+id/gameList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <!-- divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F1F1F"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOOLS"
            android:textColor="#6B7280"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="12dp" />

        <!-- loader.lua — auto-detects game by PlaceId -->
        <Button
            android:id="@+id/loaderBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Loader (auto-detect game)"
            android:backgroundTint="#1E1B4B"
            android:textColor="#A5B4FC"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
